{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"],
      "@infra/*": ["packages/infra/src/*"],
      "@app/*": ["apps/app/src/*"],
      "@yona/core": ["packages/core/src/index.ts"],
      "@yona/core/*": ["packages/core/src/*"],
      "@yona/infra": ["packages/infra/src/index.ts"],
      "@yona/infra/*": ["packages/infra/src/*"],
      "@yona/auth": ["packages/auth/src/index.ts"],
      "@yona/auth/*": ["packages/auth/src/*"],
      "@yona/contracts": ["packages/contracts/src/index.ts"],
      "@yona/contracts/*": ["packages/contracts/src/*"],
      "@yona/db": ["packages/db/src/index.ts"],
      "@yona/db/*": ["packages/db/src/*"],
      "@yona/domain": ["packages/domain/src/index.ts"],
      "@yona/domain/*": ["packages/domain/src/*"],
      "@yona/integrations": ["packages/integrations/src/index.ts"],
      "@yona/integrations/*": ["packages/integrations/src/*"],
      "@yona/i18n": ["packages/i18n/src/index.ts"],
      "@yona/i18n/*": ["packages/i18n/src/*"],
      "@yona/ui": ["packages/ui/src/index.ts"],
      "@yona/ui/*": ["packages/ui/src/*"],
      "@yona/vcs": ["packages/vcs/src/index.ts"],
      "@yona/vcs/*": ["packages/vcs/src/*"],
      "@drizzle/mysql/*": ["drizzle/mysql/*"],
      "@drizzle/pg/*": ["drizzle/pg/*"],
      "@drizzle/sqlite/*": ["drizzle/sqlite/*"]
    }
  }
}
