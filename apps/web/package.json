{
  "name": "@yona/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:db": "vitest run src/lib/server/db/*.spec.ts",
    "test:db:node": "vitest run src/lib/server/db/pg.spec.ts src/lib/server/db/mysql.spec.ts src/lib/server/db/migrations.spec.ts",
    "test:db:node:coverage": "vitest run src/lib/server/db/pg.spec.ts src/lib/server/db/mysql.spec.ts src/lib/server/db/migrations.spec.ts --coverage.enabled --coverage.allowExternal=false --coverage.include=\"src/lib/server/db/**/*.ts\" --coverage.include=\"src/lib/server/test-utils/database.ts\" --coverage.reportsDirectory=coverage/db-node --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "test": "bun run test:unit -- --run && bun run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@yona/api": "workspace:*",
    "@yona/core": "workspace:*",
    "@yona/infra": "workspace:*",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "hono": "^4.12.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.10.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@testcontainers/mysql": "^11.12.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/pg": "^8.15.6",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "bun": "file:./src/lib/server/bun-package",
    "drizzle-kit": "^1.0.0-beta.15-859cf75",
    "mysql2": "^3.18.2",
    "pg": "^8.16.3",
    "playwright": "^1.58.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "testcontainers": "^11.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2"
  }
}
