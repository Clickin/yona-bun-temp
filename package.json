{
  "name": "@yona/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:cargo-test": "node tools/agent-cargo-test.mjs",
    "agent:turn-commit": "node tools/agent-turn-commit.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:mounted": "node scripts/dev-mounted.mjs",
    "doctor:react": "react-doctor --project @yona/rust-frontend --offline --full --fail-on warning",
    "doctor:react:precommit": "react-doctor --project @yona/rust-frontend --offline --full --fail-on warning",
    "test:dev-scripts": "node --test scripts/dev-config.spec.mjs scripts/playwright-e2e-runtime.spec.mjs tests/precommit-hook-contract.test.mjs tests/design-harness-contract.test.mjs tests/agent-turn-commit-hook-contract.test.mjs tests/agent-cargo-test-harness-contract.test.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.45.0",
    "oxlint": "1.63.0",
    "react-doctor": "0.1.4"
  },
  "packageManager": "pnpm@10.32.1"
}
