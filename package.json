{
  "name": "yona-bun-temp",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "verify:agents": "bun ./tools/verify-agents-integrity.mjs",
    "dev": "bun run --cwd apps/app dev",
    "build": "bun run --cwd apps/app build",
    "preview": "bun run --cwd apps/app preview",
    "prepare": "husky",
    "lint:ox": "oxlint .",
    "format:check": "oxfmt --check .",
    "precommit:verify": "node ./tools/precommit-verify.mjs",
    "lint:imports": "bun run ./tools/lint-import-conventions.ts",
    "lint": "bun run lint:imports",
    "check": "bun run verify:agents && bun run lint:imports && bun run --cwd apps/app check",
    "check:watch": "bun run --cwd apps/app check:watch",
    "migrate:generate:pg": "drizzle-kit generate --config=drizzle-pg.config.ts",
    "migrate:generate:mysql": "drizzle-kit generate --config=drizzle-mysql.config.ts",
    "migrate:generate:sqlite": "drizzle-kit generate --config=drizzle-sqlite.config.ts",
    "migrate:generate": "bun run migrate:generate:pg && bun run migrate:generate:mysql && bun run migrate:generate:sqlite",
    "test:unit": "bun run --cwd apps/app test:unit",
    "test": "bun run --cwd apps/app test",
    "test:db": "bun run --cwd packages/db test && bun run --cwd packages/db test:sqlite",
    "test:db:native": "bun tests/bun-native-db-test.ts",
    "test:db:node": "bun run --cwd packages/db test:node",
    "test:db:node:coverage": "bun run --cwd packages/db test:node:coverage",
    "test:db:node:smoke": "node tests/node-db-smoke.mjs",
    "test:db:hybrid": "node tests/hybrid-testcontainers-node.mjs",
    "test:e2e": "bun run --cwd apps/app test"
  },
  "dependencies": {},
  "devDependencies": {
    "@testcontainers/mysql": "^10.0.0",
    "@testcontainers/postgresql": "^10.0.0",
    "bun": "file:tools/bun-package",
    "drizzle-kit": "1.0.0-beta.15-859cf75",
    "drizzle-orm": "1.0.0-beta.15-859cf75",
    "husky": "^9.1.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "testcontainers": "^10.0.0",
    "typescript": "^5.9.3"
  }
}
