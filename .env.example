# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Yona
# Root data directory (git repositories, logs, local sqlite file by default)
YONA_DATA=.yona-data

# Comma-separated numeric user ids (optional)
YONA_ADMIN_USER_IDS=

# Trusted public origin for absolute links in self-serve auth emails
YONA_PUBLIC_ORIGIN=http://localhost:3001

# API token signing secret
# Required in production so persisted per-user API tokens can be reconstructed safely.
YONA_API_TOKEN_SECRET=

# Session cookie settings
AUTH_SESSION_COOKIE_NAME=yona_session
AUTH_SESSION_COOKIE_MAX_AGE=2592000
AUTH_SESSION_COOKIE_SECURE=false

# Database
# Dialect: sqlite | postgres | mysql
YONA_DB_DIALECT=sqlite

# Runtime DB connection URL.
# - Required for postgres/mysql
# - Optional for sqlite (defaults to: sqlite://./.yona-data/yona.db)
YONA_DB_URL=

# Replace a legacy Yona SHA-256 password with Argon2id after successful login.
YONA_AUTH_HASHING_SILENT_MIGRATION_TO_ARGON2ID=false

# Dialect-specific URLs used by infra scripts (db:migrate:* / db:smoke:*)
YONA_DB_URL_POSTGRES=postgres://yona:yona@localhost:54329/yona
YONA_DB_URL_MYSQL=mysql://yona:yona@localhost:33069/yona
YONA_DB_URL_SQLITE=sqlite://./.yona-data/yona.db

# SMTP (required in production for self-serve password reset)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
