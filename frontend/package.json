{
  "name": "@yoram/rust-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3101",
    "predev": "pnpm build:legacy-css",
    "build:legacy-css": "node scripts/build-legacy-css.mjs",
    "prebuild": "pnpm build:legacy-css",
    "build": "vite build && node scripts/verify-stylex-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3101",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../scripts/run-wtr-e2e.mjs",
    "test:e2e:fallback-off": "VITE_DISABLE_LEGACY_FALLBACK=1 node ../scripts/run-wtr-e2e.mjs",
    "test:e2e:stylex-fast": "node ../scripts/stylex-verification-profile.mjs --profile fast --",
    "test:e2e:stylex-final": "node ../scripts/stylex-verification-profile.mjs --profile final --",
    "test:watch": "vitest",
    "test:e2e:wtr": "node ../scripts/run-wtr-e2e.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.170.18",
    "framer-motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-chrome": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "less": "^4.6.7",
    "puppeteer-core": "^25.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.32.1"
}
